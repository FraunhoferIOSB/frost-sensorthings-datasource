{
  "name": "frost-sensorthings-datasource",
  "version": "0.1.0",
  "description": "A data source plugin for loading data from OGC SensorThings APIs into Grafana.",
  "keywords": [
    "SensorThings API",
    "FROST",
    "grafana",
    "OGC"
  ],
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "build:backend": "make backend",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "e2e": "yarn exec cypress install && yarn exec grafana-e2e run",
    "e2e:update": "yarn exec cypress install && yarn exec grafana-e2e run --update-screenshots",
    "lint": "eslint --cache --ignore-path ./.gitignore --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "yarn run lint --fix",
    "server": "docker-compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "homepage": "https://github.com/FraunhoferIOSB/frost-sensorthings-datasource",
  "bugs": "https://github.com/FraunhoferIOSB/frost-sensorthings-datasource/issues",
  "repository": "github:FraunhoferIOSB/frost-sensorthings-datasource",
  "author": {
    "name": "Fraunhofer IOSB",
    "email": "frost@iosb.fraunhofer.de",
    "url": "https://www.iosb.fraunhofer.de/ILT"
  },
  "dependencies": {
    "@grafana/data": "^11.6.16",
    "@grafana/runtime": "^11.6.16",
    "@grafana/ui": "^11.6.16",
    "@material-table/core": "^5.1.9",
    "@material-ui/core": "^4.12.4",
    "dayjs": "^1.11.23",
    "jsonata": "^2.2.2",
    "jsonpath-plus": "^10.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@grafana/e2e": "10.4.12",
    "@grafana/e2e-selectors": "10.4.12",
    "@grafana/eslint-config": "^7.0.0",
    "@grafana/tsconfig": "^2.2.0",
    "@swc/core": "^1.16.1",
    "@swc/helpers": "^0.5.23",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "copy-webpack-plugin": "^13.0.0",
    "emotion": "10.0.27",
    "eslint-webpack-plugin": "^4.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^10.5.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.6",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-livereload-plugin": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
